{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "DatabaseSettings": {
    "ConnectionPooling": {
      "Enabled": true,
      "MinPoolSize": 10,
      "MaxPoolSize": 200,
      "ConnectionLifetime": 300,
      "ConnectionIdleLifetime": 600,
      "CommandTimeout": 30,
      "EnableRetryOnFailure": true,
      "MaxRetryCount": 5,
      "MaxRetryDelay": "00:00:30",
      "DbContextPoolSize": 1024,
      "DbContextPoolMinSize": 10
    }
  }
}
