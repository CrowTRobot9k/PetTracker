{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "PetTracker.Infrastucture.Services.ImageCompressionService": "Information",
      "PetTracker.Infrastucture.Services.PetService": "Information"
    }
  },
  "DatabaseSettings": {
    "ConnectionPooling": {
      "Enabled": true,
      "MinPoolSize": 5,
      "MaxPoolSize": 50,
      "ConnectionLifetime": 300,
      "ConnectionIdleLifetime": 600,
      "CommandTimeout": 30,
      "EnableRetryOnFailure": true,
      "MaxRetryCount": 5,
      "MaxRetryDelay": "00:00:30",
      "DbContextPoolSize": 256,
      "DbContextPoolMinSize": 5
    }
  },
  "ImageCompression": {
    "MaxSizeKB": 150,
    "TimeoutSeconds": 15,
    "MemoryCheckMultiplier": 4
  }
}
